{
    // Cmd+Shift+B で、開いている .cpp を g++-15 でビルドして同じフォルダに a.out を作る
    "version": "2.0.0",
    "tasks": [
        {
            "label": "g++-15 build (current file)",
            "type": "shell",
            "command": "/opt/homebrew/bin/g++-15",
            "args": [
                "-std=c++20",
                "-O2",
                "-Wall",
                "-o",
                "${fileDirname}/a.out",
                "${file}"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": [
                "$gcc"
            ]
        }
    ]
}
